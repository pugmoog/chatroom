[Unit]
Description=Pugmoog ephemeral chat service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/pugmoog-chat
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3040
Environment=DATA_DIR=/var/lib/pugmoog-chat
Environment=ALLOWED_ORIGINS=https://pugmoog.github.io
ExecStart=/usr/local/bin/node /opt/pugmoog-chat/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pugmoog-chat

[Install]
WantedBy=multi-user.target
